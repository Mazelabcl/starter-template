{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "image-gen-output",
  "title": "Image generation output",
  "description": "Producido por la skill image-gen tras correr gpt-image-2 (generate / edit / batch). Una entrada por imagen producida.",
  "type": "object",
  "required": ["agent", "model", "produced_at", "images"],
  "additionalProperties": false,
  "properties": {
    "agent": { "type": "string", "minLength": 1 },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "ej. gpt-image-2"
    },
    "produced_at": { "type": "string", "format": "date-time" },
    "batch_id": { "type": "string" },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "prompt", "size"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^.+\\.(png|PNG|jpg|JPG|jpeg|JPEG|webp|WEBP)$",
            "description": "Ruta relativa al PNG producido. Debe existir cuando se emite el output."
          },
          "prompt": { "type": "string", "minLength": 1 },
          "size": {
            "type": "string",
            "pattern": "^[0-9]+x[0-9]+$"
          },
          "references_used": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "name_in_prompt"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "name_in_prompt": {
                  "type": "string",
                  "minLength": 1,
                  "description": "El nombre literal usado en el texto del prompt (Image 1, char_pax, etc.). Si no se menciona, el modelo ignora la ref."
                }
              }
            }
          },
          "seed": { "type": "integer" },
          "cost_usd": { "type": "number", "minimum": 0 },
          "validated_multimodal": {
            "type": "boolean",
            "description": "true si se hizo Read multimodal del PNG después de generar."
          }
        }
      }
    }
  }
}
