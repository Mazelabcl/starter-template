{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "critic-output",
  "title": "Critic layer output",
  "description": "Producido por Capa 2 (Critic interno multi-óptica) del pipeline v2. NO es el cold-reader gate; este critic evalúa con scores numéricos y sugiere mejoras.",
  "type": "object",
  "required": ["agent", "model", "produced_at", "target_artifact", "scores", "issues", "verdict"],
  "additionalProperties": false,
  "properties": {
    "agent": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string", "format": "date-time" },
    "target_artifact": {
      "type": "string",
      "minLength": 1,
      "description": "Path o id del artefacto evaluado"
    },
    "scores": {
      "type": "array",
      "minItems": 1,
      "description": "Una entrada por criterio. La suma o promedio lo decide el consumer.",
      "items": {
        "type": "object",
        "required": ["criterion", "score"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "rationale": { "type": "string" }
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "Problemas concretos encontrados. Vacío si critic no detectó ninguno.",
      "items": {
        "type": "object",
        "required": ["severity", "location", "description"],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["info", "minor", "major", "blocker"]
          },
          "location": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "iterate", "reject"]
    }
  }
}
