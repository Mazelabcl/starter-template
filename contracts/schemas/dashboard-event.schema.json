{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dashboard-event",
  "title": "Dashboard event (shape de events[] que dispara animaciones)",
  "type": "object",
  "required": ["type", "timestamp"],
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["task_started", "task_completed", "task_failed", "council_invoked", "image_generated", "handoff_validated", "contract_violation", "decision_emitted", "skill_invoked", "agent_invoked"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "task_id":   { "type": "string" },
    "agent":     { "type": "string" },
    "payload":   { "type": "object" }
  }
}
