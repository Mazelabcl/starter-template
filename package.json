{
  "name": "aldot-starter-template",
  "version": "0.2.0",
  "type": "module",
  "description": "Starter template con OpenRouter (Perplexity), gpt-image-2 paralelo, pipeline v2 de orquestación de agentes, y entrevista /kickoff al usuario.",
  "scripts": {
    "start": "node scripts/start_dashboard.js",
    "setup": "node setup.js",
    "setup-python": "node -e \"import('./setup.js')\" || node setup.js",
    "research": "node src/research.js",
    "test:contracts": "node contracts/test.js",
    "test:dashboard": "node dashboard-server.test.js && node dashboard-chat.test.js && node --test dashboard-public-mode.test.js",
    "test:skills-catalog": "node skills-catalog.test.js",
    "test:load-env": "node dashboard-load-env.test.js",
    "test:roadmap-sync": "node roadmap-state-sync.test.js",
    "test:review-app": "node review-app.test.js",
    "test:image-refs": "node dashboard-image-refs.test.js",
    "review-app": "node review-app/server.js",
    "smoke": "node scripts/smoke_test.js",
    "smoke:quick": "node scripts/smoke_test.js --quick",
    "dashboard": "node dashboard/server.js",
    "voz": "node scripts/voice_tts.js",
    "postinstall": "node setup.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
