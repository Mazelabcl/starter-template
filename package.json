{
  "name": "aldot-starter-template",
  "version": "0.6.0-dev",
  "type": "module",
  "description": "Starter template Mazelab v6-dev: kit de contexto + herramientas (research con Perplexity vía OpenRouter, imágenes con gpt-image-2 y otros modelos, memoria, roadmap con /idea, review-app, councils).",
  "scripts": {
    "setup": "node setup.js",
    "setup-python": "node setup.js --python-only",
    "test": "node scripts/run_tests.js",
    "research": "node src/research.js",
    "review-app": "node review-app/server.js",
    "cockpit": "node cockpit/server.js",
    "test:cockpit": "node cockpit.test.js",
    "smoke": "node scripts/smoke_test.js",
    "smoke:quick": "node scripts/smoke_test.js --quick",
    "test:skills-catalog": "node skills-catalog.test.js",
    "test:load-env": "node load-env.test.js",
    "test:review-app": "node review-app.test.js",
    "test:image-refs": "node image-refs.test.js",
    "test:image-wrappers": "node image-wrappers.test.js",
    "postinstall": "node setup.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
