OPENROUTER_API_KEY=sk-or-v1-pega-aqui-tu-key
OPENAI_API_KEY=sk-proj-pega-aqui-tu-key
# Opcional: token de Replicate para image-explorer (FLUX, Imagen 3, Ideogram, Recraft, SD 3.5).
# Sin esto image-explorer queda con solo gpt-image-2 disponible.
# Sácalo en https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=optional-pega-aqui-tu-key
# Opcional: subir concurrencia de gpt-image-2 si tu tier OpenAI lo permite (default 8)
# OPENAI_IMAGE_CONCURRENCY=15
# Opcional: key de Gemini para Nano Banana Pro (gemini-3-pro-image) vía scripts/gemini_images.py.
# Sin esto, el wrapper de Nano Banana Pro falla con mensaje claro de setup.
# Sácala en https://aistudio.google.com/apikey
GEMINI_API_KEY=optional-pega-aqui-tu-key
