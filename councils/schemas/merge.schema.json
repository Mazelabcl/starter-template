{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "council-merge",
  "title": "Síntesis integrada (fase 2). Las voces vienen anonimizadas (A, B, C...).",
  "type": "object",
  "required": ["integrated_proposal_md", "contributions", "tensions", "recommendation", "confidence", "what_would_change_it"],
  "properties": {
    "integrated_proposal_md": { "type": "string", "minLength": 40 },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "voice", "type", "adopted", "why"],
        "properties": {
          "text": { "type": "string", "minLength": 3 },
          "voice": { "type": "string", "minLength": 1 },
          "type": { "enum": ["threat", "opportunity", "idea"] },
          "adopted": { "type": "boolean" },
          "why": { "type": "string", "minLength": 3 }
        }
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["between", "issue", "suggested_resolution"],
        "properties": {
          "between": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "issue": { "type": "string", "minLength": 3 },
          "suggested_resolution": { "type": "string", "minLength": 3 }
        }
      }
    },
    "recommendation": { "type": "string", "minLength": 10 },
    "confidence": { "enum": ["alta", "media", "baja"] },
    "what_would_change_it": { "type": "string", "minLength": 3 }
  }
}
