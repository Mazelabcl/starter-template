.env
.env.local
node_modules/
.venv/
__pycache__/
*.pyc
.DS_Store
*.log
.claude/settings.local.json

# Project-specific outputs (no van al template)
content/principles.md
content/INDEX.md
content/output/
workshop1/

# Process-log: solo findings-for-template.md va al template; lo demás es del proyecto activo
process-log/0*.md
process-log/1*.md
process-log/W*.md
process-log/_*.md

# Dashboard v3 — assets binarios CC0 (poblados por scripts/fetch_default_pack.js)
assets/vendor/

# Dashboard v3.1 — chat público (runtime data, generado por POST /api/chat)
dashboard/chat-log.jsonl

# review-app (Sprint v3.1) — reviews persistidas (datos del proyecto consumer, no del template)
review-app/audit/reviews/

# 00-decisions.md sí va al template — es ley canónica
!process-log/00-decisions.md

# Higiene — runtime state que el código recrea solo (no va al repo)
dashboard/state.json
memory/voice-mode-state.json

# Contracts declarados en runtime — solo el .gitkeep va al template
contracts/declared/*.json
!contracts/declared/.gitkeep

# Councils results — generados en runtime; solo el .gitkeep va al template
councils/results/*.json
!councils/results/.gitkeep

# Exploraciones de imágenes (outputs efímeros del proyecto consumer)
content/explorations/

# Caché local
.cache/

# Imágenes de prueba sueltas que dejan algunos scripts en la raíz
/output.png
/edited.png
