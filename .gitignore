.env
.env.local
node_modules/
.venv/
__pycache__/
*.pyc
.DS_Store
*.log
.claude/settings.local.json
# Worktrees de agentes (temporales, viven fuera del historial)
.claude/worktrees/

# Project-specific outputs (no van al template)
content/principles.md
content/INDEX.md
content/output/
content/explorations/
workshop1/

# Process-log: solo findings-for-template.md va al template; lo demás es del proyecto activo
process-log/0*.md
process-log/1*.md
process-log/W*.md
process-log/_*.md

# 00-decisions.md sí va al template (histórico de decisiones; ya no se carga en cada sesión)
!process-log/00-decisions.md

# review-app — reviews persistidas (datos del proyecto consumer, no del template)
review-app/audit/reviews/

# cockpit — revisiones y feedback son datos del proyecto consumer, no del template.
# Se ignora todo el contenido salvo el .gitkeep; el ejemplo vive en cockpit/ejemplo-review.json.
cockpit/reviews/*
cockpit/feedback/*
!cockpit/reviews/.gitkeep
!cockpit/feedback/.gitkeep

# astra-bridge — pedidos y resultados de Codex son datos del proyecto; solo README y .gitkeep van al template
astra-bridge/pedidos/*
astra-bridge/resultados/*
!astra-bridge/pedidos/.gitkeep
!astra-bridge/resultados/.gitkeep

# Councils results — generados en runtime; solo el .gitkeep va al template
councils/results/*.json
!councils/results/.gitkeep

# bold-rounds — copias de trabajo, screenshots y variantes de cada corrida (datos del proyecto)
/rounds/
/rounds-*/

# Generados
/RESUMEN.html

# Caché local
.cache/

# Imágenes de prueba sueltas que dejan algunos scripts en la raíz
/output.png
/edited.png
