{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brazos-directorio",
  "title": "Directorio de brazos (integraciones para ejecutar)",
  "description": "Cada entrada es una integración (API, MCP, CLI, skill, librería, plugin o conector) que le da al orquestador capacidad de EJECUTAR. La lee src/brazos.js.",
  "type": "object",
  "required": ["version", "actualizado", "entradas"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "actualizado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nota": { "type": "string" },
    "entradas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entrada" }
    }
  },
  "definitions": {
    "entrada": {
      "type": "object",
      "required": ["id", "nombre", "tipo", "categoria", "para_que", "cuando_usar", "keywords", "link", "costo", "oficial", "como_conectar", "auth", "check", "riesgos", "verificado"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
        "nombre": { "type": "string", "minLength": 2 },
        "tipo": { "enum": ["api", "mcp", "cli", "skill", "libreria", "plugin", "conector"] },
        "categoria": { "enum": ["web", "datos", "research", "creativo-imagen", "creativo-video", "creativo-3d", "audio", "marketing", "trading", "productividad", "deploy"] },
        "para_que": { "type": "string", "minLength": 10, "maxLength": 160 },
        "cuando_usar": { "type": "string", "minLength": 10 },
        "keywords": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 2 } },
        "link": { "type": "string", "pattern": "^(https?://|[A-Za-z]:\\\\|~|\\./|src/|scripts/)" },
        "costo": { "type": "string", "minLength": 2 },
        "oficial": { "type": "boolean" },
        "recomendado": { "type": "boolean" },
        "como_conectar": {
          "type": "object",
          "required": ["pasos"],
          "additionalProperties": false,
          "properties": {
            "comando": { "type": "string" },
            "pasos": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
          }
        },
        "auth": {
          "type": "object",
          "required": ["necesita", "credencial"],
          "additionalProperties": false,
          "properties": {
            "necesita": { "type": "boolean" },
            "credencial": { "type": "string" },
            "env_var": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$" }
          }
        },
        "check": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tipo", "valor"],
            "additionalProperties": false,
            "properties": {
              "tipo": { "enum": ["env", "mcp", "cli", "file", "plugin", "manual"] },
              "valor": { "type": "string", "minLength": 1 },
              "rol": { "enum": ["instalacion", "auth"] }
            }
          }
        },
        "mcp": {
          "description": "Solo para tipo mcp: lo que se escribe en .mcp.json. Las keys van como ${VAR}, nunca el valor.",
          "type": "object",
          "additionalProperties": false,
          "required": ["nombre"],
          "properties": {
            "nombre": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
            "url": { "type": "string", "pattern": "^https://" },
            "transport": { "enum": ["http", "sse"] },
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^\\$\\{[A-Z][A-Z0-9_]*\\}$" } },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "riesgos": { "type": "string" },
        "verificado": {
          "type": "object",
          "required": ["ok", "fecha"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "fuente": { "type": "string" }
          }
        }
      }
    }
  }
}
